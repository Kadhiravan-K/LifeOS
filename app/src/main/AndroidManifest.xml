<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System Boot Receiver (Guarded strictly by system RECEIVE_BOOT_COMPLETED permission) -->
        <receiver
            android:name=".notifications.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Internal LifeOS Reminders & Alarms Receiver (Completely private / unexported) -->
        <receiver
            android:name=".notifications.ReminderBroadcastReceiver"
            android:exported="false" />

        <!-- LifeOS Quick Reminders Home-Screen Widget -->
        <receiver
            android:name=".widgets.QuickRemindersWidgetProvider"
            android:exported="true"
            android:label="LifeOS Quick Reminders">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.lifeos.ACTION_WIDGET_TOGGLE_TASK" />
                <!-- RC-6 fix: ensure widget is restored after device reboot / app update -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeos_quick_reminders_widget_info" />
        </receiver>

        <!-- LifeOS Smart Trackers Home-Screen Widget -->
        <receiver
            android:name=".widgets.TrackerWidgetProvider"
            android:exported="true"
            android:label="LifeOS Smart Trackers">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeos_tracker_widget_info" />
        </receiver>

        <!-- LifeOS Subscriptions Home-Screen Widget -->
        <receiver
            android:name=".widgets.SubscriptionWidgetProvider"
            android:exported="true"
            android:label="LifeOS Subscriptions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeos_subscription_widget_info" />
        </receiver>

        <!-- LifeOS Productivity Radar Home-Screen Widget (#17) -->
        <receiver
            android:name=".widgets.ProductivityRadarWidgetProvider"
            android:exported="true"
            android:label="LifeOS Productivity Radar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lifeos_productivity_radar_widget_info" />
        </receiver>

        <service
            android:name=".widgets.QuickRemindersRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
