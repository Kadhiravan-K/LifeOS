<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark rounded background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#18181B" />
            <stroke android:width="1dp" android:color="#27272A" />
        </shape>
    </item>
    <!-- Accent Header Bar -->
    <item android:top="12dp" android:left="12dp" android:right="12dp" android:height="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#2610B981" />
        </shape>
    </item>
    <!-- Center Radar Polygon simulation -->
    <item android:top="36dp" android:bottom="36dp" android:left="24dp" android:right="24dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#3310B981" />
            <solid android:color="#1A10B981" />
        </shape>
    </item>
    <!-- Bottom Score bar -->
    <item android:bottom="12dp" android:left="12dp" android:right="12dp" android:height="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
