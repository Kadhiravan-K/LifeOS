<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Tile 0 -->
    <RelativeLayout
        android:id="@+id/tile_0_container"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_0_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tile Shape"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/tile_0_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tile_0_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Tile"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tile_0_check"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="2dp"
            android:contentDescription="Completed"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Tile 1 -->
    <RelativeLayout
        android:id="@+id/tile_1_container"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_1_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tile Shape"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/tile_1_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tile_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Tile"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tile_1_check"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="2dp"
            android:contentDescription="Completed"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Tile 2 -->
    <RelativeLayout
        android:id="@+id/tile_2_container"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="2dp">

        <ImageView
            android:id="@+id/tile_2_shape"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Tile Shape"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/tile_2_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tile_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Tile"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/tile_2_check"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="2dp"
            android:contentDescription="Completed"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
