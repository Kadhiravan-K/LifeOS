<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:gravity="center"
    android:padding="2dp">

    <!-- Shaped background (Hexagon, Circle, Square) -->
    <ImageView
        android:id="@+id/widget_item_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Tile Shape"
        android:scaleType="fitCenter" />

    <!-- Center content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/widget_item_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⚡"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tile"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Completed Checkmark Badge -->
    <ImageView
        android:id="@+id/widget_item_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="2dp"
        android:contentDescription="Completed"
        android:src="@android:drawable/checkbox_on_background"
        android:visibility="gone" />
</RelativeLayout>
