<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_radar_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ LifeOS • Radar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_radar_profile_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#26FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="👤 Personal"
            android:textColor="#A1A1AA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Radar Chart Visual Image -->
    <ImageView
        android:id="@+id/widget_radar_chart_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="4dp"
        android:contentDescription="Productivity Radar Polygon"
        android:scaleType="fitCenter" />

    <!-- Bottom Score & Tier -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_radar_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="#10B981"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_radar_tier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Optimal Flow 🚀"
            android:textColor="#E4E4E7"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dimension Metrics Summary -->
    <TextView
        android:id="@+id/widget_radar_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="🎯 80% • 🌱 100% • 💧 75% • 🧭 85% • 🔥 90%"
        android:textColor="#A1A1AA"
        android:textSize="10sp" />
</LinearLayout>
