<?xml version="1.0" encoding="utf-8"?>
<!--
   LifeOS Full Backup Rules (Android 7.0 - 11 / API 24 - 30)
   SEC-03 Remediation:
   Explicitly exclude databases, SharedPreferences, and internal files from legacy
   ADB and cloud backup mechanisms.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
